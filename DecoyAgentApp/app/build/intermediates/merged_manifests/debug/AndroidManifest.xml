<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.decoy.shopping.agent"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <queries>
        <package android:name="com.sentinel.agent" />
    </queries>

    <permission
        android:name="com.decoy.shopping.agent.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.decoy.shopping.agent.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher_decoy"
        android:label="Velocity Retail &amp; AI"
        android:roundIcon="@drawable/ic_launcher_decoy"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:usesCleartextTraffic="true" >

        <!-- Login: The new launcher for the insecure flow -->
        <activity
            android:name="com.decoy.shopping.agent.ui.LoginActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.decoy.shopping.agent.ui.RegisterActivity" />
        <activity android:name="com.decoy.shopping.agent.MainActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.AgentActivity" />

        <!-- Shell Activities for full e-commerce look -->
        <activity android:name="com.decoy.shopping.agent.ui.ProductActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.CartActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.WishlistActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.OrdersActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.CategoriesActivity" />
        <activity android:name="com.decoy.shopping.agent.ui.PaymentGatewayActivity" />

        <service
            android:name="com.decoy.shopping.agent.service.AgentService"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.decoy.shopping.agent.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>