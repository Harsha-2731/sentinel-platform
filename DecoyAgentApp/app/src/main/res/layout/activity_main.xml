<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VELOCITY_RETAIL"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Promotion Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="#111827" android:padding="24dp">
                    <TextView android:id="@+id/promoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTONOMOUS_SALE" android:textColor="#10B981" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <TextView android:layout_below="@id/promoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Let our AI agent find yours." android:textColor="#9CA3AF" android:textSize="12sp" android:layout_marginTop="4dp"/>
                    <Button android:id="@+id/btnOpenAgent" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_alignParentBottom="true" android:background="#10B981" android:text="START_SHOPPING_AGENT" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:paddingHorizontal="16dp"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="16dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCatAll" android:layout_width="wrap_content" android:layout_height="32dp" android:text="All" android:backgroundTint="#111827" android:textColor="#FFFFFF" android:textSize="10sp" android:paddingHorizontal="12dp" />
                    <Button android:id="@+id/btnCatElectronics" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Electronics" android:backgroundTint="#F3F4F6" android:textColor="#111827" android:textSize="10sp" android:layout_marginStart="8dp" android:paddingHorizontal="12dp" />
                    <Button android:id="@+id/btnCatClothing" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Clothing" android:backgroundTint="#F3F4F6" android:textColor="#111827" android:textSize="10sp" android:layout_marginStart="8dp" android:paddingHorizontal="12dp" />
                    <Button android:id="@+id/btnCatShoes" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Shoes" android:backgroundTint="#F3F4F6" android:textColor="#111827" android:textSize="10sp" android:layout_marginStart="8dp" android:paddingHorizontal="12dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fresh Arrivals"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/productRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
