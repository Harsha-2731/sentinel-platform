<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header (Razorpay Blue) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3399FF"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Razorpay"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEST MODE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#1A5276"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Layout for Card Entry -->
    <LinearLayout
        android:id="@+id/layoutCardEntry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Payment Summary -->
                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount: ₹500"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="32dp" />

                <!-- Payment Methods Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT METHODS"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Mock UPI/Netbanking (Disabled look) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/editbox_background"
                    android:padding="16dp"
                    android:alpha="0.5"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPI / QR Code" android:textColor="#374151" />
                </LinearLayout>

                <!-- Card Details (Active) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:drawable/editbox_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Card (Visa, Mastercard, RuPay)"
                        android:textColor="#3399FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="4111 1111 1111 1111"
                        android:inputType="number"
                        android:background="@null"
                        android:textColor="#111827" />
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etExpiry"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="MM / YY"
                            android:inputType="date"
                            android:background="@null"
                            android:textColor="#111827" />

                        <EditText
                            android:id="@+id/etCvv"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:hint="CVV"
                            android:inputType="numberPassword"
                            android:background="@null"
                            android:textColor="#111827" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your payment is 256-bit SSL encrypted."
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Pay Button -->
        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Proceed to Pay"
            android:backgroundTint="#3399FF"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_margin="16dp" />
    </LinearLayout>

    <!-- Layout for OTP Verification (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutOtpEntry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3D Secure Verification"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We have sent an OTP to your registered mobile number ending in ****88."
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:hint="0 0 0 0"
            android:inputType="number"
            android:gravity="center"
            android:letterSpacing="1.0"
            android:textSize="24sp"
            android:textColor="#111827"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Verify &amp; Confirm"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend OTP in 25s"
            android:textColor="#3399FF"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
