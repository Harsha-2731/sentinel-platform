<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Navigation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:letterSpacing="0.05"
                android:text="SENTINEL_EDR"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#9CA3AF" />
        </RelativeLayout>

        <!-- Integrity Status Widget -->
        <LinearLayout
            android:id="@+id/integrityStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_modern"
            android:backgroundTint="#0D1117"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:id="@+id/integrityStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#00FFCC"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/integrityStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM INTEGRITY: SECURE"
                android:textColor="#00FFCC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Risk Gauge (Main Visualization) -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp">

            <ProgressBar
                android:id="@+id/riskProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@android:drawable/progress_horizontal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/riskScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="#FFFFFF"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RISK_SEVERITY"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Auth Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card_modern"
            android:backgroundTint="#0A0E17"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/authStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTHORIZED / SECURE"
                android:textColor="#00FFCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THREAT_TIMELINE (30M)"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="32dp" />

        <LinearLayout
            android:id="@+id/timelineLayout"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:background="#0D1117"
            android:padding="4dp">
            <!-- Dynamic blocks here -->
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#33FF3366" android:layout_margin="1dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#1A00FFCC" android:layout_margin="1dp"/>
        </LinearLayout>

        <!-- Events List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE SECURITY TRAILS"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eventsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:overScrollMode="never"
            android:background="@android:color/transparent" />

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp">

            <Button
                android:id="@+id/historyBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="TASK_LOG"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/simulateAttackBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="ROGUE_SIM"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="#FF3366"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
