<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#880000"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="80sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY LOCKDOWN"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sentinel's 24/7 Background Guardian is active. We have intercepted an autonomous suspicious activity performed without your interaction."
            android:textColor="#FFCC00"
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY BREACH REPORT"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/emergencyReasoningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Critical anomaly detected. Revoking all AI Agent authorities."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#33000000"
            android:padding="16dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/biometricStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY FOR VERIFICATION"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/cancelEmergencyBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CANCEL (REQUIRES BIOMETRIC)"
            android:layout_marginTop="32dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#880000" />

    </LinearLayout>

</RelativeLayout>
