<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#880000"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="80sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY LOCKDOWN"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/emergencyReasoningText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Critical anomaly detected. Revoking all AI Agent authorities."
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/cancelEmergencyBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CANCEL (REQUIRES BIOMETRIC)"
            android:layout_marginTop="32dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#880000" />

    </LinearLayout>

</RelativeLayout>
